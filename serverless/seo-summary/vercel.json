{
  "functions": {
    "api/**/*.mjs": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/seo-summary/v1/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/seo-summary/v1/current", "destination": "/api/current" },
    { "source": "/seo-summary/v1/history", "destination": "/api/history" }
  ]
}
