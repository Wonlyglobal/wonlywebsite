[Unit]
Description=WONLY SEO summary read API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/wonly-seo-summary/image.env
ExecStartPre=-/usr/bin/docker rm -f wonly-seo-summary-api
ExecStart=/usr/bin/docker run --rm --name wonly-seo-summary-api --network host --read-only --cap-drop ALL --security-opt no-new-privileges --tmpfs /tmp:rw,noexec,nosuid,size=16m --user 8796:8796 --env-file /etc/wonly-seo-summary/api.env --volume /var/lib/wonly-seo-summary:/data:rw ${SEO_SUMMARY_IMAGE} node scripts/run-seo-summary-api.mjs
ExecStop=/usr/bin/docker stop -t 20 wonly-seo-summary-api
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0077

[Install]
WantedBy=multi-user.target
