[Unit]
Description=WONLY SEO summary read API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wonly-seo
Group=wonly-seo
WorkingDirectory=/opt/wonly-seo-summary/current
EnvironmentFile=/etc/wonly-seo-summary/api.env
ExecStart=/usr/bin/env node scripts/run-seo-summary-api.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wonly-seo-summary
UMask=0077

[Install]
WantedBy=multi-user.target
