[Unit]
Description=Generate WONLY live SEO summary snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=wonly-seo
Group=wonly-seo
WorkingDirectory=/opt/wonly-seo-summary/current
EnvironmentFile=/etc/wonly-seo-summary/collector.env
ExecStart=/usr/bin/env node scripts/generate-live-seo-summary.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wonly-seo-summary
UMask=0077
