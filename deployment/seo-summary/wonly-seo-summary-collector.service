[Unit]
Description=Generate WONLY live SEO summary snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/wonly-seo-summary/image.env
ExecStart=/usr/bin/docker run --rm --name wonly-seo-summary-collector --network host --read-only --cap-drop ALL --security-opt no-new-privileges --tmpfs /tmp:rw,noexec,nosuid,size=16m --user 8796:8796 --env-file /etc/wonly-seo-summary/collector.env --volume /var/lib/wonly-seo-summary:/data:rw ${SEO_SUMMARY_IMAGE} node scripts/generate-live-seo-summary.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0077
