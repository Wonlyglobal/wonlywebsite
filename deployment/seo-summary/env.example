# Install as /etc/wonly-seo-summary/api.env, owner root:wonly-seo, mode 0640.
# Never commit a populated copy.
PORT=8796
SEO_SUMMARY_STORE_DIR=/var/lib/wonly-seo-summary
SEO_SUMMARY_CLIENTS_JSON={"crm-grace-prod":"replace-with-at-least-32-random-secret-bytes"}

# Install separately as /etc/wonly-seo-summary/collector.env.
# SEO_SUMMARY_STORE_DIR=/var/lib/wonly-seo-summary
# GOOGLE_SA_KEY={"type":"service_account","project_id":"replace-on-server"}
# GA4_PROPERTY_ID=replace-on-server
# GSC_SITE=sc-domain:wonlyglobal.com
