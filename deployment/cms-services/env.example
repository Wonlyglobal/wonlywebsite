# Copy only the variables required by each service into /etc/wonly-cms/<service>.env.
# Set owner root:wonly-cms and mode 0640. Never commit populated copies.

# Common values
CMS_SUPABASE_URL=https://PROJECT_REF.supabase.co
CMS_SUPABASE_SERVICE_ROLE_KEY=replace-on-server
CMS_PUBLIC_SITE_ORIGIN=https://www.wonlyglobal.com

# admin.env — PORT 8789
CMS_ENTRYPOINT=scripts/run-cms-admin-api.mjs
PORT=8789
CMS_ADMIN_ALLOWED_ORIGIN=https://cms.wonlyglobal.com

# analytics.env — PORT 8790
# CMS_ENTRYPOINT=scripts/run-cms-analytics-api.mjs
# PORT=8790
# CMS_ANALYTICS_ALLOWED_ORIGIN=https://cms.wonlyglobal.com
# GOOGLE_SA_KEY={"type":"service_account","project_id":"replace-on-server"}
# GA4_PROPERTY_ID=replace-on-server
# GSC_SITE=sc-domain:wonlyglobal.com

# health.env — PORT 8791
# CMS_ENTRYPOINT=scripts/run-cms-integration-health-api.mjs
# PORT=8791
# CMS_HEALTH_ALLOWED_ORIGIN=https://cms.wonlyglobal.com
# CMS_INTEGRATION_HEALTH_TARGETS={}

# backup.env — PORT 8792
# CMS_ENTRYPOINT=scripts/run-cms-backup-api.mjs
# PORT=8792
# CMS_BACKUP_ALLOWED_ORIGIN=https://cms.wonlyglobal.com
# CMS_STAGING_DATABASE_URL=replace-on-server
# CMS_PRODUCTION_DATABASE_URL=replace-on-server

# ai.env — PORT 8793
# CMS_ENTRYPOINT=scripts/run-cms-ai-api.mjs
# PORT=8793
# CMS_AI_ALLOWED_ORIGIN=https://cms.wonlyglobal.com
# DEEPSEEK_API_KEY=replace-on-server
# DEEPSEEK_MODEL=deepseek-chat

# quality.env — PORT 8794
# CMS_ENTRYPOINT=scripts/run-cms-quality-api.mjs
# PORT=8794
# CMS_QUALITY_ALLOWED_ORIGIN=https://cms.wonlyglobal.com

# deploy.env — PORT 8795
# CMS_ENTRYPOINT=scripts/run-cms-deploy-api.mjs
# PORT=8795
# CMS_DEPLOY_ALLOWED_ORIGIN=https://cms.wonlyglobal.com
# CMS_DEPLOY_TARGETS={}

# Worker-only values (run with separate timer/service units)
# CMS_WEBHOOK_ENDPOINTS={}
# CMS_WEBHOOK_POLL_MS=10000
